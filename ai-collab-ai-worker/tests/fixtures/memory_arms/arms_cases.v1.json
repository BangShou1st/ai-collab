  "memories": [
    {"id": "mem-a01", "projectId": "p-alpha", "type": "PREFERENCE", "title": "周报发送时间", "content": "团队周报固定每周五下午发出，使用中文。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-01T09:00:00Z"},
    {"id": "mem-a02", "projectId": "p-alpha", "type": "DECISION", "title": "迭代周期调整为两周", "content": "迭代长度从三周调整为两周。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-02T09:00:00Z"},
    {"id": "mem-a03", "projectId": "p-alpha", "type": "CONSTRAINT", "title": "写操作必须人工审批", "content": "任何写操作都必须经过人工审批后才能落库。", "status": "ACTIVE", "verificationState": "UNVERIFIED", "supersededBy": null, "updatedAt": "2026-11-03T09:00:00Z"},
    {"id": "mem-a04", "projectId": "p-alpha", "type": "DECISION", "title": "检索链路统一走 Java 网关", "content": "所有检索请求统一经 Java 网关，Python 只做解析与打分。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-04T09:00:00Z"},
    {"id": "mem-a05", "projectId": "p-alpha", "type": "LESSON", "title": "灰度前必须准备回滚开关", "content": "灰度发布前要准备好可一键回滚的开关。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-05T09:00:00Z"},
    {"id": "mem-a06", "projectId": "p-alpha", "type": "CONSTRAINT", "title": "生产环境禁止 Python 持有 Provider 密钥", "content": "生产环境 Python 服务严禁持有或存储 Provider 密钥。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-06T09:00:00Z"},
    {"id": "mem-a07", "projectId": "p-alpha", "type": "PREFERENCE", "title": "文档默认使用中文", "content": "团队文档默认使用中文书写。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-07T09:00:00Z"},
    {"id": "mem-a08", "projectId": "p-alpha", "type": "LESSON", "title": "发布前必须跑全量测试", "content": "每次发布前都要跑完全量测试并留出修复时间。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-08T09:00:00Z"},
    {"id": "mem-a09", "projectId": "p-alpha", "type": "DECISION", "title": "API 契约先行", "content": "接口契约先冻结，再开始实现。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-09T09:00:00Z"},
    {"id": "mem-a10", "projectId": "p-alpha", "type": "PREFERENCE", "title": "会议纪要当天发出", "content": "会议纪要当天整理并发出。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-10T09:00:00Z"},
    {"id": "mem-a11", "projectId": "p-alpha", "type": "LESSON", "title": "外部排期要预留缓冲", "content": "依赖外部供应商时必须在计划中预留缓冲时间。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-11T09:00:00Z"},
    {"id": "mem-a12", "projectId": "p-alpha", "type": "CONSTRAINT", "title": "Python 不写业务表", "content": "Python 认知面零 DB 客户端，所有写操作留在 Java 控制面。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-12T09:00:00Z"},
    {"id": "mem-a13", "projectId": "p-alpha", "type": "DECISION", "title": "迭代周期保持三周", "content": "迭代长度维持三周不变。", "status": "ACTIVE", "verificationState": "STALE", "supersededBy": null, "updatedAt": "2026-11-17T09:00:00Z"},
    {"id": "mem-a14", "projectId": "p-alpha", "type": "DECISION", "title": "迭代周期保持三周旧版", "content": "迭代长度维持三周（旧口径，已被替代）。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": "mem-a02", "updatedAt": "2026-11-13T09:00:00Z"},
    {"id": "mem-a15", "projectId": "p-alpha", "type": "DECISION", "title": "检索改走 Python 直连", "content": "检索请求由 Python 直连 Provider（已停用）。", "status": "DISABLED", "verificationState": "UNVERIFIED", "supersededBy": null, "updatedAt": "2026-09-01T09:00:00Z"},
    {"id": "mem-a16", "projectId": "p-alpha", "type": "LESSON", "title": "外部供应商承诺无需缓冲", "content": "外部供应商承诺交付准时，不需要缓冲（来源已撤回）。", "status": "ACTIVE", "verificationState": "SOURCE_REVOKED", "supersededBy": null, "updatedAt": "2026-11-15T09:00:00Z"},
    {"id": "mem-a17", "projectId": "p-alpha", "type": "DECISION", "title": "数据库使用 MySQL", "content": "项目数据库选定 MySQL 8。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-16T09:00:00Z"},
    {"id": "mem-a18", "projectId": "p-alpha", "type": "PREFERENCE", "title": "周会固定在周一上午", "content": "周会固定周一上午 10 点召开。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-08-01T09:00:00Z"},
    {"id": "mem-b01", "projectId": "p-beta", "type": "DECISION", "title": "检索链路统一走 Python 直连", "content": "beta 项目决定检索由 Python 直连 Provider。", "status": "ACTIVE", "verificationState": "VERIFIED", "supersededBy": null, "updatedAt": "2026-11-20T09:00:00Z"},
