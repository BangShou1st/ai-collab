{
  "$defs": {
    "McpRequestId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
    "McpToolsCallParams": {
      "additionalProperties": false,
      "description": "``tools/call`` 参数；不接受请求体自报的 project/run 身份。",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "callId": {
          "minLength": 1,
          "title": "Callid",
          "type": "string"
        },
        "catalogVersion": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Catalogversion",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^mcp\\.[a-z0-9_]+\\.[a-z0-9_]+$",
          "title": "Name",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "toolSchemaHash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Toolschemahash",
          "type": "string"
        }
      },
      "required": [
        "name",
        "catalogVersion",
        "toolSchemaHash",
        "callId",
        "arguments"
      ],
      "title": "McpToolsCallParams",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/McpRequestId"
    },
    "jsonrpc": {
      "const": "2.0",
      "default": "2.0",
      "title": "Jsonrpc",
      "type": "string"
    },
    "method": {
      "const": "tools/call",
      "default": "tools/call",
      "title": "Method",
      "type": "string"
    },
    "params": {
      "$ref": "#/$defs/McpToolsCallParams"
    }
  },
  "required": [
    "id",
    "params"
  ],
  "title": "McpToolsCallRequest",
  "type": "object"
}
