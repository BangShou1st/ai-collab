# local.env 格式样例：真实文件由 install.ps1 / install.sh 首次安装时自动生成，
# 内含随机凭据，绝不提交 Git（已在 .gitignore 排除）。内容不支持 shell 展开、
# 引号或行内注释。再次运行安装命令不会覆盖已有值（幂等）。
APP_IMAGE=REQUIRED_BACKEND_IMAGE_REF
WEB_IMAGE=REQUIRED_FRONTEND_IMAGE_REF
HTTP_PORT=8080
POSTGRES_DB=ai_collab
POSTGRES_USER=ai_collab
POSTGRES_PASSWORD=REQUIRED_RANDOM_POSTGRES_PASSWORD
REDIS_PASSWORD=REQUIRED_RANDOM_REDIS_PASSWORD
MINIO_ROOT_USER=ai-collab
MINIO_ROOT_PASSWORD=REQUIRED_RANDOM_MINIO_ADMIN_PASSWORD
MINIO_BUCKET=ai-collab
JWT_SECRET=REQUIRED_RANDOM_JWT_SECRET
MODEL_CONFIG_MASTER_KEY=REQUIRED_RANDOM_MODEL_MASTER_KEY
AUTH_PUBLIC_REGISTRATION_ENABLED=true
AGENT_RUNTIME_ALLOWED=true
BACKUP_RETENTION_DAYS=14
# 可观测性 O1：Grafana 面板 UI 宿主机端口（仅绑 127.0.0.1）；指标/trace 数据面
# （app 管理端口 8081、prometheus 9090、tempo 3200/4317）只走 compose 内网，不发布。
GRAFANA_PORT=3000
# M1 MQ 迁移：文档处理链路消息总闸。本地一键部署默认开启（RocketMQ 容器在同拓扑内）；
# 设为 false 可完全回落进程内路径（回落模式带 Redisson 跨实例互斥锁，Redis 深化 P2）。
MQ_ENABLED=true
