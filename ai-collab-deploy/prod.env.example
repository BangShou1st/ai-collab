# 仅为格式示例；所有 REQUIRED_* 值均须在受控位置替换，不能作为生产配置。
# 内容不支持 shell 展开、引号或行内注释。不要将实际配置提交到仓库。
APP_IMAGE=REQUIRED_APP_IMAGE_WITH_SHA256_DIGEST
# 代理/静态资源镜像：使用与后端同版本的前端镜像（Nginx + 内置静态资源），
# 不再要求宿主机先执行 pnpm build。旧部署迁移见 docs/deployment/migration.md。
PROXY_IMAGE=REQUIRED_FRONTEND_IMAGE_WITH_SHA256_DIGEST
PUBLIC_BIND_IP=0.0.0.0
HTTPS_PORT=443
TLS_CERT_FILE=/srv/ai-collab/tls/fullchain.pem
TLS_KEY_FILE=/srv/ai-collab/tls/privkey.pem
AUTH_ALLOWED_ORIGINS=https://collab.example.org
MINIO_PUBLIC_ENDPOINT=https://storage.example.org
# 必须在飞书后台登记相同的 HTTPS 回调地址；未使用用户授权时可留空。
FEISHU_OAUTH_REDIRECT_URI=
# 恢复演练在隔离入口后暂停异步清理，恢复完成并经批准后再启用。
CONNECTOR_CLEANUP_ENABLED=true
AUTH_PUBLIC_REGISTRATION_ENABLED=true
POSTGRES_DB=ai_collab
POSTGRES_USER=ai_collab
POSTGRES_PASSWORD=REQUIRED_RANDOM_POSTGRES_PASSWORD
REDIS_PASSWORD=REQUIRED_RANDOM_REDIS_PASSWORD
MINIO_ROOT_USER=collab-admin
MINIO_ROOT_PASSWORD=REQUIRED_RANDOM_MINIO_ADMIN_PASSWORD
MINIO_ACCESS_KEY=collab-app
MINIO_SECRET_KEY=REQUIRED_RANDOM_MINIO_APP_PASSWORD
MINIO_BUCKET=ai-collab
JWT_SECRET=REQUIRED_RANDOM_JWT_SECRET
MODEL_CONFIG_MASTER_KEY=REQUIRED_RANDOM_MODEL_MASTER_KEY
# 运维环境 Agent 运行许可（默认 true；设为 false 则完全不创建 Agent Worker 线程池，用于紧急熔断）：
AGENT_RUNTIME_ALLOWED=true
# Chat 与 Agent 日常开关已由「动态配置中心」网页管理接管，此处保留作为初始缺省 (false)：
CHAT_ENABLED=false
AGENT_ENABLED=false
# MCP 外部工具白名单主机（逗号分隔）：留空表示禁止任何 MCP 外部网络访问。
AGENT_MCP_ALLOWED_HOSTS=
# 可观测性 O1：生产无面板容器（设计 §5），app 仅在管理端口 8081（compose 内网，
# 不映射宿主机、不经 nginx）暴露 health,info,prometheus，由运维侧抓取方案经内网访问。
# OTLP 导出目标：默认 http://tempo:4317（生产无 tempo 时导出在后台静默失败，不影响请求）；
# 需要真实 trace 时改为自建 collector 地址。
OTEL_EXPORTER_OTLP_ENDPOINT=
# 文档链路固定走 RocketMQ（容器常驻，无 profile）。false 仅用于运维紧急关闭：
# 文档注册返回 503，不回落进程内执行；恢复为 true 后由恢复任务重新派发。
MQ_ENABLED=true
# RocketMQ 业务 topic 与消费组（rocketmq-topic-init 按同名变量显式声明，两者必须一致）。
ROCKETMQ_DOCUMENT_TOPIC=document-processing
ROCKETMQ_CONSUMER_GROUP=document-processing-consumer
# 内部 AI 令牌只有 Ed25519 一种（无模式开关）：app 持签发私钥（PKCS#8 DER base64，必填），
# KID 默认 k1；INTERNAL_AI_ED25519_PUBLIC_KEYS 仅轮换期需要。install.sh 会幂等生成私钥。
INTERNAL_AI_ED25519_PRIVATE_KEY=REQUIRED_ED25519_PKCS8_DER_BASE64
INTERNAL_AI_ED25519_KID=k1
# 数据库角色（db-init 每次 up 以超级用户 POSTGRES_USER 幂等创建/同步；install.sh 会幂等生成密码）：
# APP_DB_PASSWORD 属于非超级业务角色 ai_collab_app（app 连库与 Flyway 迁移只用它）；
# POSTGRES_USER/POSTGRES_PASSWORD 仅供 db-init 与备份，不注入 app。
APP_DB_PASSWORD=REQUIRED_RANDOM_APP_DB_PASSWORD
AI_WORKER_DB_PASSWORD=REQUIRED_RANDOM_AI_WORKER_DB_PASSWORD
