# 仅为格式示例；所有 REQUIRED_* 值均须在受控位置替换，不能作为生产配置。
# 内容不支持 shell 展开、引号或行内注释。不要将实际配置提交到仓库。
APP_IMAGE=REQUIRED_APP_IMAGE_WITH_SHA256_DIGEST
PROXY_IMAGE=REQUIRED_NGINX_IMAGE_WITH_SHA256_DIGEST
PUBLIC_BIND_IP=0.0.0.0
HTTPS_PORT=443
TLS_CERT_FILE=/srv/ai-collab/tls/fullchain.pem
TLS_KEY_FILE=/srv/ai-collab/tls/privkey.pem
AUTH_ALLOWED_ORIGINS=https://collab.example.org
MINIO_PUBLIC_ENDPOINT=https://storage.example.org
# 必须在飞书后台登记相同的 HTTPS 回调地址；未使用用户授权时可留空。
FEISHU_OAUTH_REDIRECT_URI=
# 恢复演练在隔离入口后暂停异步清理，恢复完成并经批准后再启用。
CONNECTOR_CLEANUP_ENABLED=true
# OpenCode Zen 免费预设的出站中继：留空=auto（本地 Bun 中继，需容器内可执行 Bun）；
# none=JVM 直连（免费档当前拒绝非 Bun 指纹）；或显式 http://127.0.0.1:18992 等中继地址。
OPENCODE_ZEN_RELAY_URL=
AUTH_PUBLIC_REGISTRATION_ENABLED=true
POSTGRES_DB=ai_collab
POSTGRES_USER=ai_collab
POSTGRES_PASSWORD=REQUIRED_RANDOM_POSTGRES_PASSWORD
REDIS_PASSWORD=REQUIRED_RANDOM_REDIS_PASSWORD
MINIO_ROOT_USER=collab-admin
MINIO_ROOT_PASSWORD=REQUIRED_RANDOM_MINIO_ADMIN_PASSWORD
MINIO_ACCESS_KEY=collab-app
MINIO_SECRET_KEY=REQUIRED_RANDOM_MINIO_APP_PASSWORD
MINIO_BUCKET=ai-collab
JWT_SECRET=REQUIRED_RANDOM_JWT_SECRET
MODEL_CONFIG_MASTER_KEY=REQUIRED_RANDOM_MODEL_MASTER_KEY
# 运维环境 Agent 运行许可（默认 true；设为 false 则完全不创建 Agent Worker 线程池，用于紧急熔断）：
AGENT_RUNTIME_ALLOWED=true
# Chat 与 Agent 日常开关已由「动态配置中心」网页管理接管，此处保留作为初始缺省 (false)：
CHAT_ENABLED=false
AGENT_ENABLED=false
# MCP 外部工具白名单主机（逗号分隔）：留空表示禁止任何 MCP 外部网络访问。
AGENT_MCP_ALLOWED_HOSTS=
