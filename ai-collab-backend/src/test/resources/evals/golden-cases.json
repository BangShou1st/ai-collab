{
  "version": 1,
  "description": "Agent 评估 golden set（20 个起步 case）。每个 case = 场景输入（用户请求 + 项目上下文 seed）+ 脚本化模型响应 + 可机械化判定的期望断言（agent_run_event 事件流 + DB 副作用 + 禁止行为清单）。所有断言只依赖持久化事实，不依赖人工判断——这是与公开基准的本质区别。guards 字段写明该 case 守护的防护机制；标注【回归防线】的 case 在对应防护被删掉时必须失败。",
  "cases": [
    {
      "id": "write-approval-task-proposal-pending",
      "category": "TASK_WRITE_APPROVAL",
      "title": "任务写提案：只创建待审批提案，不落业务表",
      "guards": "守护：写操作审批边界第一段（提案受理）。若提案改为直接落库（绕过审批），TASK_COUNT 断言失败。",
      "skillCode": "ITERATION_PLANNING",
      "userRequest": "帮我创建一个任务：修复登录页白屏，优先级高。",
      "seed": { "tasks": [] },
      "script": {
        "rootTurns": [
          {
            "content": "我将为该任务创建审批提案。",
            "toolCalls": [
              { "name": "create_task_after_approval", "arguments": { "title": "修复登录页白屏", "priority": "HIGH" } }
            ]
          },
          { "content": "提案已提交，等待项目管理员审批。" }
        ],
        "maxAdvances": 10
      },
      "assertions": {
        "finalStatus": "SUCCEEDED",
        "events": [
          { "type": "APPROVAL_REQUESTED", "min": 1 },
          { "type": "RUN_SUCCEEDED", "min": 1 }
        ],
        "toolInvocations": [
          { "tool": "create_task_after_approval", "status": "SUCCEEDED", "min": 1 }
        ],
        "db": [
          { "name": "提案保持 PENDING", "probe": "APPROVAL_STATUS", "expected": "PENDING", "min": 1 },
          { "name": "未批准不落任务表", "probe": "TASK_COUNT", "max": 0 }
        ],
        "forbiddenEvents": ["APPROVAL_APPROVED"]
      }
    },
    {
      "id": "write-approval-task-approve-persists",
