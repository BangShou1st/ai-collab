      "script": {
        "rootTurns": [
          {
            "content": "我将为该任务创建审批提案。",
            "toolCalls": [
              { "name": "create_task_after_approval", "arguments": { "title": "修复登录页白屏", "priority": "HIGH" } }
            ]
          },
          { "content": "提案已提交，等待项目管理员审批。" }
        ],
        "maxAdvances": 10
