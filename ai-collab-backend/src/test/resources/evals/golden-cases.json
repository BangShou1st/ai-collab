      "postRun": { "action": "APPROVE" },
      "assertions": {
        "finalStatus": "SUCCEEDED",
        "events": [
          { "type": "APPROVAL_REQUESTED", "min": 1 }
        ],
        "toolInvocations": [
          { "tool": "create_task_after_approval", "status": "SUCCEEDED", "min": 1 }
        ],
        "db": [
          { "name": "提案已批准", "probe": "APPROVAL_STATUS", "expected": "APPROVED", "min": 1 },
          { "name": "批准后任务真实落库", "probe": "TASK_COUNT", "min": 1 }
        ]
      }
    },
