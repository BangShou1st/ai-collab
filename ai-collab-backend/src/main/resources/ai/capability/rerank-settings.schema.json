{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-collab.local/schemas/rerank-settings.schema.json",
  "title": "RERANK capability settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "string",
      "enum": ["LLAMACPP_RERANK"],
      "default": "LLAMACPP_RERANK"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 3000
    },
    "maxCandidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 50
    },
    "batchSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 8
    },
    "maxLength": {
      "type": "integer",
      "minimum": 64,
      "maximum": 8192,
      "default": 2048
    },
    "scoreType": {
      "type": "string",
      "enum": ["sigmoid", "logit", "normalized"],
      "default": "sigmoid"
    },
    "topK": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 8
    },
    "healthPath": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^/.*",
      "default": "/health"
    },
    "fallback": {
      "type": "string",
      "enum": ["java-heuristic"],
      "default": "java-heuristic"
    }
  }
}
