# ==============================================================================
# AI Collab 环境变量配置模板 (.env.example)
# 复制本文件为 .env 并根据实际环境替换占位符：
#   Linux/macOS: [ -e .env ] || cp .env.example .env
#   Windows:     if (!(Test-Path .env)) { Copy-Item .env.example .env }
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础数据库 (PostgreSQL 17 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=ai_collab
POSTGRES_USER=ai_collab
POSTGRES_PASSWORD=change-me

# ------------------------------------------------------------------------------
# 2. 缓存与分布式锁 (Redis 7)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=change-me

# ------------------------------------------------------------------------------
# 3. 对象存储 (MinIO)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=ai-collab
MINIO_ROOT_PASSWORD=change-me-now
MINIO_BUCKET=ai-collab

# ------------------------------------------------------------------------------
# 4. 认证、系统安全与初始管理员
# ------------------------------------------------------------------------------
# JWT 签名密钥（至少 32 字节高强度随机字符串）
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# Access Token 有效期（分钟）。默认 15；撤销生效不依赖该时长，缩短仅作纵深防御。
JWT_ACCESS_TOKEN_MINUTES=15

# 是否开放公开注册（生产环境建议设为 false，由管理员建号）
AUTH_PUBLIC_REGISTRATION_ENABLED=true

# 默认初始管理员账号（系统初始化自动就绪）
DEMO_OWNER_USERNAME=owner
DEMO_OWNER_PASSWORD=change-me-now

# 模型敏感凭据加密主密钥（32 字节 AES 密钥，保护存储在数据库中的用户 API Key）
MODEL_CONFIG_MASTER_KEY=replace-with-a-long-random-master-key

# Refresh Token Cookie 安全标记。默认 true（生产基线，要求 HTTPS 或 TLS 终止代理）。
# 本地开发（local profile）不受此变量影响，固定走 HTTP 的非 Secure Cookie。
# 仅当搭建纯 HTTP 的容器演练环境时才允许改为 false，且必须同时把
# REFRESH_COOKIE_ALLOW_INSECURE 设为 true，否则后端启动即失败（安全守卫）。
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_ALLOW_INSECURE=false

# 认证端点 CORS 白名单（逗号分隔的精确 Origin；容器化部署时 Compose 透传给后端）。
# 生产必须改为实际前端站点 Origin，例如 https://aicollab.example.edu。
AUTH_ALLOWED_ORIGINS=http://localhost:5173

# 飞书项目级连接 OAuth 回调地址（完整 URL，路径必须为 /api/v1/connector/oauth/callback）。
# 授权端点 authen/v1/authorize 与令牌端点 authen/v2/oauth/token 要求两者 redirect_uri 完全一致，
# 且必须在飞书开放平台「安全设置 -> 重定向 URL」中登记。
# 本地开发示例：https://<开发者可用的 HTTPS 回调域名>/api/v1/connector/oauth/callback
# 本地不启用飞书连接时留空即可，其他功能不受影响（dev.ps1 doctor 会提示状态）。
FEISHU_OAUTH_REDIRECT_URI=

# 统一可信公开地址（正式前端访问源，只允许 origin，不带路径/查询参数）。
# 邀请链接、密码重置、邮箱验证等敏感链接仅基于该配置生成；
# 未配置时邀请链接由前端按当前页面 Origin 拼接，邮件类链接则跳过发送。
APP_PUBLIC_URL=

# 邮件发送（邀请/密码重置/邮箱验证）。MAIL_ENABLED=false 时仅记录发送意图，不投递。
# 启用后必须提供 MAIL_HOST 与 MAIL_FROM；凭据只写入部署环境，禁止提交真实值。
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=AI Collab <no-reply@example.edu>
MAIL_STARTTLS=true
# 465 等隐式 SSL 端口（QQ/163 邮箱）置 true；587 STARTTLS 端口保持 false。
MAIL_SSL=false

# 本地联调建议（无需外部凭据）：
#   docker compose --env-file .env -f ai-collab-deploy/docker-compose.yml --profile maildev up -d mailpit
#   然后 MAIL_ENABLED=true、MAIL_HOST=localhost、MAIL_PORT=1025、APP_PUBLIC_URL=http://localhost:5173
#   收件箱界面 http://localhost:8025 。生产环境严禁启用 maildev profile。

# ------------------------------------------------------------------------------
# 4.5 文档处理链路 MQ（RocketMQ，M1 迁移）
# MQ_ENABLED 是文档链路消息总闸（灰度开关）：
#   false（默认）：文档链路完全回落进程内线程池路径。Redis 深化 P2 后回落模式增加
#     Redisson 跨实例互斥锁（同 documentId tryLock(0) 互斥，锁不可用时降级放行），
#     多实例部署不再重复派发；正确性仍由状态机 CAS（UPLOADED→PARSING 条件更新）
#     最终兜底，锁只是减少无效竞争的效率优化。
#   true：上传/重试/批量重建索引经 RocketMQ 派发，消费幂等三重保障（状态机 CAS、
#     idempotency_record、状态前置校验），消息丢失由 5 分钟对账兜底恢复 Job 处理。
# 开启时需要可达的 NameServer 地址；容器部署由 compose 注入 rocketmq-namesrv:9876。
# ------------------------------------------------------------------------------
MQ_ENABLED=false
ROCKETMQ_NAMESRV_ADDR=localhost:9876
ROCKETMQ_DOCUMENT_TOPIC=document-processing
ROCKETMQ_CONSUMER_GROUP=document-processing-consumer

# ------------------------------------------------------------------------------
# 5. 全局动态配置中心说明 (L2 业务配置已迁移至数据库)
# ------------------------------------------------------------------------------
# 业务功能开关（CHAT_ENABLED / AGENT_ENABLED / AGENT_WORKER_CONCURRENCY 等）
# 已由「动态配置中心」接管（系统管理员在 Web 后台「管理中心 -> 动态配置中心」
# 实时控制，持久化存储于 PostgreSQL 并经 Redis 广播多实例实时同步，无须重启服务）。
# 
# 运维紧急熔断开关 (L1 部署配置)：
# AGENT_RUNTIME_ALLOWED：控制应用容器是否允许创建 Agent Worker 运行时环境。
# 默认 true。若设置为 false，应用将彻底不加载 Agent 执行线程池与调度定时器（用于紧急运维熔断）。
AGENT_RUNTIME_ALLOWED=true

# 历史业务开关（已由动态配置中心接管，仅作为无数据库记录时的初次回退）：
# CHAT_ENABLED=false
# CHAT_PROVIDER=openai-compatible
# CHAT_BASE_URL=https://api.openai.com
# CHAT_API_KEY=
# CHAT_MODEL=gpt-4o-mini
# CHAT_TEMPERATURE=0.2
# CHAT_MAX_OUTPUT_TOKENS=1200

# ------------------------------------------------------------------------------
# 6. 向量模型 (Embedding，用于 RAG 知识库与文档语义检索)
# 生产/容器部署的向量模型不通过环境变量配置：由系统管理员在
# 「AI Infrastructure」界面配置并加密入库（密钥经 MODEL_CONFIG_MASTER_KEY 加密）。
# 历史遗留的 EMBEDDING_ENABLED / EMBEDDING_PROVIDER / EMBEDDING_BASE_URL /
# EMBEDDING_API_KEY / EMBEDDING_MODEL / EMBEDDING_DIMENSIONS / EMBEDDING_BATCH_SIZE
# 等变量已无运行时消费点，设置它们不会改变系统行为，故不再列出。
# 唯一真实生效的 Embedding 环境变量是本地 Ollama endpoint 白名单（容器部署时
# Compose 会透传；app 容器访问宿主机 Ollama 用 host.docker.internal，不是 127.0.0.1）：
# EMBEDDING_LOCAL_ALLOWED_TARGETS=host.docker.internal:11434
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 7. AI 任务规划引擎 (两阶段任务拆解)
# 规划模型本体不走环境变量：按用户级 AI Provider 分配（个人设置 -> AI 设置）
# 解析。历史遗留的 PLANNING_ENABLED / PLANNING_PROVIDER / PLANNING_BASE_URL /
# PLANNING_API_KEY / PLANNING_MODEL 已无运行时消费点，不再列出。
# 以下为真实生效的调优参数（括号内为默认值，可按需覆盖）：
# ------------------------------------------------------------------------------
PLANNING_GENERATION_LIMIT_PER_USER_HOUR=60
# PLANNING_MAX_OUTPUT_TOKENS=6000
# PLANNING_MAX_SOURCES=12
# PLANNING_SOURCE_CODEPOINT_BUDGET=16000
# PLANNING_RETRIEVAL_THRESHOLD=0.55
# PLANNING_EXECUTOR_CORE_SIZE=2
# PLANNING_EXECUTOR_MAX_SIZE=4
# PLANNING_EXECUTOR_QUEUE_CAPACITY=20

# ------------------------------------------------------------------------------
# 8. 协作 Agent 与 MCP 工具网关
# ------------------------------------------------------------------------------
# AGENT_ENABLED 与 AGENT_WORKER_CONCURRENCY 已迁移至「动态配置中心」网页管理，
# 无须在此处配置。如需彻底禁止 Agent 运行，使用上方的 AGENT_RUNTIME_ALLOWED=false。
#
# MCP 外部工具白名单（逗号分隔的域名或 IP，如 mcp.example.com；留空表示禁止外部访问）：
AGENT_MCP_ALLOWED_HOSTS=
# 仅 local/test 的真实进程 E2E 使用；默认关闭，生产启用会启动失败。
# AGENT_MCP_TEST_LOOPBACK_ENABLED=false

# W6 P1 内部 MCP Gateway 默认关闭；关闭时不装配 /internal/ai/v1/mcp，旧 McpAgentToolProvider 继续工作。
# 静态三项绑定只允许 local/test profile 显式配置；生产必须留空并使用 Ed25519 claims。
# AGENT_MCP_GATEWAY_ENABLED=false
# AGENT_MCP_GATEWAY_STATIC_TEST_PROJECT_REF=
# AGENT_MCP_GATEWAY_STATIC_TEST_RUN_REF=
# AGENT_MCP_GATEWAY_STATIC_TEST_CATALOG_VERSION=

# 管理员共享 Provider 发布准入（D4 最小阈值；默认只拦截明显超时/不稳定，不代表容量）：
# AI_PROVIDER_ADMISSION_SAMPLES=3
# AI_PROVIDER_ADMISSION_P95_MAX_MS=10000
# AI_PROVIDER_ADMISSION_MAX_TIMEOUTS=0
# AI_PROVIDER_ADMISSION_MAX_FAILURES=0

# ------------------------------------------------------------------------------
# 9. 知识库速率限制
# ------------------------------------------------------------------------------
KNOWLEDGE_RATE_LIMIT_PER_USER_HOUR=60

# ------------------------------------------------------------------------------
# 10. 本地栈端口(与 CostOps 等其他本地项目共存时覆盖;默认值=历史行为)
# ------------------------------------------------------------------------------
# 业务后端端口(Spring SERVER_PORT);actuator 管理端口默认 8081,可再覆盖
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081
# 中间件宿主机端口(compose 映射与 application-local.yml 共用)
AI_COLLAB_PG_HOST_PORT=5432
AI_COLLAB_REDIS_HOST_PORT=6379
AI_COLLAB_MINIO_HOST_PORT=9000
AI_COLLAB_MINIO_CONSOLE_HOST_PORT=9001
# 本地 MinIO 完整端点(必须与上面 MINIO 宿主端口一致)
MINIO_ENDPOINT=http://localhost:9000
# postgres 数据卷名(延续历史数据卷时覆盖,如验收数据集)
AI_COLLAB_PG_DATA_VOLUME=ai_collab_postgres_data

# ------------------------------------------------------------------------------
# 11. 本地真进程 AI 能力（默认关闭；按需取消注释）
# ------------------------------------------------------------------------------
# 仅 local profile 允许 loopback；生产默认仍为空串且非 local/test 启动会失败。
# AI_OUTBOUND_LOCAL_ALLOWED_TARGETS=127.0.0.1:3425
#
# ai-worker-api（Python 认知面）地址；Java 网关默认 8080，本地隔离栈需同步改端口。
# AI_WORKER_JAVA_GATEWAY_URL=http://127.0.0.1:8080
# RERANK_WORKER_BASE_URL=http://127.0.0.1:9100
# DECIDE_WORKER_BASE_URL=http://127.0.0.1:9100
# PLANNING_DRAFT_WORKER_BASE_URL=http://127.0.0.1:9100
# QUERY_PLAN_WORKER_BASE_URL=http://127.0.0.1:9100
# MEMORY_JOB_WORKER_BASE_URL=http://127.0.0.1:9100
#
# 模式默认保持 java：不依赖 worker，行为与生产安全默认一致。
# shadow = 后台对比；python = Python 主链，失败自动回退 Java。
# RERANK_MODE=java
# DECIDE_MODE=java
# PLANNING_DRAFT_MODE=java
# QUERY_PLAN_ENABLED=false
# MEMORY_JOB_ENABLED=false
#
# Memory Job 必须使用 Ed25519：私钥/公钥只经进程环境注入，绝不写入 .env 或仓库。
# 临时测试密钥使用后立即删除。
# INTERNAL_AI_TOKEN_MODE=ed25519
# AI_WORKER_TOKEN_MODE=ed25519
# INTERNAL_AI_ED25519_PRIVATE_KEY=<临时生成，不提交>
# INTERNAL_AI_ED25519_PUBLIC_KEYS=<kid>=<SPKI base64>
# INTERNAL_AI_ED25519_KID=<kid>
# AI_WORKER_ED25519_PUBLIC_KEYS=<kid>=<SPKI base64>
