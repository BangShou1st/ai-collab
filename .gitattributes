# 默认识别文本文件，并统一使用 LF
* text=auto eol=lf

# Maven Wrapper Shell 脚本可能位于子项目中
**/mvnw text eol=lf

# Windows 脚本使用 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 常见配置和源码统一使用 LF
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf

# 二进制文件禁止换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.jar binary