            "key": "Origin",
            "value": "{{frontendOrigin}}"
          }
        ],
        "url": "http://127.0.0.1:8080/api/v1/auth/refresh"
      }
    },
    {
      "name": "09 Logout Current Device",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logout is idempotent and clears the browser cookie', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().code).to.eql('SUCCESS');",
              "  pm.expect(pm.response.headers.get('Set-Cookie')).to.include('Max-Age=0');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/logout"
      }
    },
    {
      "name": "10 Refresh After Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the cleared current-device cookie cannot refresh', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().code).to.eql('AUTH_UNAUTHORIZED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/refresh"
      }
    },
    {
